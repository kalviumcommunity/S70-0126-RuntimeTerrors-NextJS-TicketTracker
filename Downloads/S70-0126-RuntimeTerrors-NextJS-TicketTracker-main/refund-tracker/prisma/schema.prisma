generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Refund {
  id            String        @id @default(cuid())
  ticketId      String
  operator      String
  platform      String
  amount        Int
  status        RefundStatus  @default(INITIATED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  logs          RefundLog[]
}

model RefundLog {
  id        String   @id @default(cuid())
  refundId  String
  action    String
  actor     String
  createdAt DateTime @default(now())

  refund    Refund   @relation(fields: [refundId], references: [id])
}

enum RefundStatus {
  INITIATED
  APPROVED
  PROCESSED
  COMPLETED
  DELAYED
}